+  { label: 'Custo neste mês', value: 'R$ 284,6 mil', note: '8,4% vs. mês anterior', icon: CircleDollarSign, tone: 'orange', up: true },
+  { label: 'RDOs no mês', value: '42', note: '100% atualizados', icon: ClipboardCheck, tone: 'blue', down: true },
