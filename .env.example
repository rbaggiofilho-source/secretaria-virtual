# ==========================================================================
# Secretária Virtual — variáveis de ambiente
# Copie para .env (local) ou configure no painel da Vercel (Production).
# NUNCA commite o .env preenchido.
# ==========================================================================

# --- WhatsApp Cloud API (Meta / Graph API) ---
# Token permanente do System User (Business Settings > Users > System users)
WHATSAPP_TOKEN=
# ID do número de telefone (WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# Token que VOCÊ escolhe; usado no handshake GET /webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret (App Settings > Basic) — valida a assinatura X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# (Opcional) Só aceita mensagens deste número (formato E.164 sem +, ex.: 5519999999999).
# Deixe vazio para aceitar de qualquer número que escrever para o bot.
ALLOWED_WHATSAPP_NUMBER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Opcional — padrão: claude-haiku-4-5 (Haiku mais recente)
ANTHROPIC_MODEL=claude-haiku-4-5

# --- STT (transcrição de áudio) ---
# Provedor: "groq" ou "openai"
STT_PROVIDER=groq
# Preencha a chave do provedor escolhido:
GROQ_API_KEY=
OPENAI_API_KEY=
# Opcional — modelos padrão: groq=whisper-large-v3, openai=whisper-1
GROQ_STT_MODEL=whisper-large-v3
OPENAI_STT_MODEL=whisper-1

# --- Google Calendar ---
# ID do seu calendário PESSOAL (Configurações do calendário > "ID do calendário").
# Para o calendário principal costuma ser o próprio e-mail.
GOOGLE_CALENDAR_ID=
# Service Account: cole o JSON INTEIRO da conta de serviço em UMA linha.
# (Compartilhe seu calendário pessoal com o client_email da conta de serviço,
#  permissão "Fazer alterações nos eventos". Passo a passo no README.)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Supabase (memória / Postgres) ---
SUPABASE_URL=
# Service role key (Settings > API). Fica SÓ no backend, nunca no cliente.
SUPABASE_SERVICE_KEY=

# --- Geral ---
# Fuso do dono. Padrão: America/Sao_Paulo
TIMEZONE=America/Sao_Paulo
